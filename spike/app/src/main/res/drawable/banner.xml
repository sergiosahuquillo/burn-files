<?xml version="1.0" encoding="utf-8"?>
<!-- 320×180 TV banner (LEANBACK_LAUNCHER). Colors come from res/values/colors.xml tokens. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="320dp" android:height="180dp" />
            <solid android:color="@color/brand_background" />
        </shape>
    </item>
    <item
        android:width="96dp"
        android:height="96dp"
        android:gravity="center"
        android:drawable="@drawable/ic_flame" />
</layer-list>
